{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window",
  "windows": [
    "main",
    "panel",
    "notch",
    "glow",
    "buddy"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/**"
        },
        {
          "path": "/Applications/Grok Bot.app"
        },
        {
          "path": "/opt/homebrew/var/log/**"
        },
        {
          "path": "/usr/local/var/log/**"
        },
        {
          "path": "/var/log/**"
        }
      ]
    },
    "notification:default",
    "autostart:default",
    "dialog:allow-open"
  ]
}
